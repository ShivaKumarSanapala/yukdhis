# Local (offline) defaults: everything runs without Google Cloud.
YUKDHIS_BACKEND=local
AGENT_MODE=agentic            # falls back to deterministic when no Vertex AI project is set
TENANT_ID=demo-bank

# Gemini on Vertex AI (enables agentic mode and chat)
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
REASONING_MODEL=gemini-2.5-pro
FAST_MODEL=gemini-2.5-flash

# Per-component overrides (local|gcp). Values below are filled by infrastructure/gcp/deploy.sh on Cloud Run.
# GRAPH_BACKEND=gcp           SPANNER_INSTANCE=  SPANNER_DATABASE=
# OPERATIONAL_BACKEND=gcp     CLOUDSQL_INSTANCE=project:region:instance  CLOUDSQL_IAM_USER=
# DOCUMENT_BACKEND=gcp        DOCUMENTAI_PROCESSOR=projects/.../locations/us/processors/...  CIRCULARS_BUCKET=
# PRIVACY_BACKEND=gcp         DLP_KMS_KEY=  DLP_WRAPPED_KEY=  (Secret Manager)
# GEMMA_BACKEND=gcp           GEMMA_VERTEX_ENDPOINT=  or  GEMMA_GKE_URL=http://gemma.internal:8000
# DISPATCH_BACKEND=gcp        PUBSUB_TOPIC=projects/.../topics/yukdhis-approved-actions
# MEMORY_BACKEND=gcp          MEMORY_BANK_AGENT_ENGINE_ID=
# AUTH_MODE=firebase          CORS_ORIGINS=https://<project>.web.app

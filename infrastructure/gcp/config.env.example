# Copy to infrastructure/gcp/config.env (gitignored) and edit.
PROJECT_ID=your-gcp-project-id
REGION=us-central1
DOCAI_LOCATION=us
TENANT_ID=demo-bank
NETWORK=default
SUBNET=default

SPANNER_INSTANCE=yukdhis-graph
SPANNER_DATABASE=bank-graph
SPANNER_PROCESSING_UNITS=100

CLOUDSQL_INSTANCE_NAME=yukdhis-pg
CLOUDSQL_TIER=db-custom-1-3840

BUCKET=${PROJECT_ID}-yukdhis-circulars
ARTIFACT_REPO=yukdhis
API_SERVICE=yukdhis-api
ACTION_SERVICE=yukdhis-action-engine
PUBSUB_TOPIC_NAME=yukdhis-approved-actions

# Gemma in-VPC redactor (Model Garden -> Vertex AI endpoint on one L4 GPU, ~INR 2,000/day). Set DEPLOY_GEMMA=1 to enable.
DEPLOY_GEMMA=0
GEMMA_MODEL=google/gemma2@gemma-2-2b-it   # 9B needs g2-standard-24 with 2x L4
GEMMA_MACHINE=g2-standard-12
# Restrict sign-in to one Google Workspace domain (optional)
ALLOWED_EMAIL_DOMAIN=

# Email for monitoring alerts (infrastructure/gcp/monitoring.sh)
ALERT_EMAIL=

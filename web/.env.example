# Cloud Run URL for the WebSocket stream (Firebase Hosting cannot proxy WebSockets).
# Leave empty locally: the Vite dev proxy forwards /api and /ws to localhost:8080.
VITE_API_BASE=
# Firebase web config (public identifiers, not secrets). Leave empty to run without sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
